# Copiar a .env.local y completar. || Copy to .env.local and fill in.
#
# NINGUNA variable de este archivo lleva el prefijo `NEXT_PUBLIC_`, y no es
# casualidad: ese prefijo inyecta el valor en el bundle del browser. Todas las
# de acá son secretos o URLs internas. El repo además es público.
# || NO variable here carries the `NEXT_PUBLIC_` prefix, and that is not an
# accident: the prefix inlines the value into the browser bundle. Everything
# here is a secret or an internal URL, and the repo is public.
#
# Secciones:
#   1. Servicio IA          obligatoria
#   2. Sesión               obligatoria
#   3. Google OAuth         obligatoria para el login con Google
#   4. Base de identidad    obligatoria


# =============================================================================
# 1. Servicio IA || AI service
# =============================================================================
# La URL del servicio IA. PRIVADA: sin prefijo `NEXT_PUBLIC_`, porque el
# browser nunca tiene que poder leerla. Toda llamada al servicio sale del
# servidor de Next (los Route Handlers de app/api/), así que el browser solo
# habla con el origen de esta app.
#
# En local: la instancia de uvicorn del servicio.
# En Vercel: la URL pública del servicio en Railway.
#
# || The AI service's URL. PRIVATE: no `NEXT_PUBLIC_` prefix, because the
# browser must never be able to read it. Every call to the service leaves from
# the Next server (the Route Handlers under app/api/), so the browser only ever
# talks to this app's own origin.
AI_SERVICE_URL=http://127.0.0.1:8000

# El token compartido con el servicio IA: viaja como `Authorization: Bearer` en
# cada llamada, y lo agrega el cliente base — ninguna pantalla lo maneja. Mismo
# valor que SERVICE_TOKEN en ai-service, y uno DISTINTO por entorno.
#
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Vacío = no se manda header. El servicio puede estar abierto a propósito en
# desarrollo (lo dice en su log de arranque), pero en producción no arranca sin
# su token.
#
# Al desplegar: PRIMERO esta variable en Vercel, DESPUÉS SERVICE_TOKEN en
# Railway. Un header que llega a un servicio abierto se ignora, así que ese
# orden no tiene ventana de caída; al revés, la consola queda con 401 hasta que
# Vercel termine.
#
# PRIVADA: sin prefijo `NEXT_PUBLIC_`, que es el mecanismo que la expondría al
# browser.
#
# || The token shared with the AI service, sent as `Authorization: Bearer` on
# every call by the base client — no screen ever handles it. Same value as
# SERVICE_TOKEN in ai-service, and a DIFFERENT one per environment. Empty means
# no header. When deploying, set this in Vercel FIRST and SERVICE_TOKEN in
# Railway second: a header reaching an open service is ignored, so that order
# has no downtime window. PRIVATE: no `NEXT_PUBLIC_` prefix.
AI_SERVICE_TOKEN=


# =============================================================================
# 2. Sesión || Session
# =============================================================================
# La clave con la que se FIRMA el JWT de sesión. Sin esto no hay login.
#
#   npx auth secret            # la genera y la escribe en .env.local
#   openssl rand -base64 32    # o a mano
#
# Rotarla invalida todas las sesiones activas: la gente vuelve a entrar y nada
# más se pierde. En Vercel se carga en el proyecto, nunca en el repo.
# || The key the session JWT is SIGNED with. No login without it. Rotating it
# invalidates every active session -- people sign in again and nothing else is
# lost.
AUTH_SECRET=

# La URL canónica de la consola. Auth.js la usa para armar los callbacks de
# OAuth, y su presencia además activa `trustHost` (verificado en
# `@auth/core/lib/utils/env.js`).
#
# En local se puede dejar vacía: Auth.js infiere el host. En Vercel, detrás de
# un proxy, hay que ponerla o los callbacks se arman contra el host interno y
# Google rechaza el redirect.
# || The console's canonical URL. Auth.js builds OAuth callbacks with it, and
# its presence also enables `trustHost`. Empty is fine locally; behind Vercel's
# proxy it must be set or callbacks get built against the internal host.
AUTH_URL=http://localhost:3000


# =============================================================================
# 3. Google OAuth
# =============================================================================
# Auth.js descubre estas dos SOLO por su nombre: `AUTH_{PROVIDER}_ID` y
# `AUTH_{PROVIDER}_SECRET` (verificado en `@auth/core/lib/utils/env.js`). Por
# eso `auth.ts` llama a `Google({})` sin pasarle credenciales. Renombrarlas
# rompe el login sin ningún error de tipos.
#
# Cómo obtenerlas, en Google Cloud Console:
#   1. APIs y servicios -> Pantalla de consentimiento OAuth. Tipo "Interno" si
#      todos los usuarios están en el mismo Workspace; "Externo" si no.
#   2. APIs y servicios -> Credenciales -> Crear credenciales -> ID de cliente
#      de OAuth -> Aplicación web.
#   3. Orígenes autorizados de JavaScript:
#        http://localhost:3000              (local)
#        https://<tu-app>.vercel.app        (producción)
#   4. URI de redireccionamiento autorizados -- la ruta es de Auth.js y tiene
#      que ir EXACTA:
#        http://localhost:3000/api/auth/callback/google
#        https://<tu-app>.vercel.app/api/auth/callback/google
#
# Ojo con el alcance de esto: la consola NO crea cuentas solas. Un login de
# Google con un email que no está en la base se rechaza, así que dar de alta a
# alguien es crear su fila primero (ver `scripts/seed-admin.ts`).
# || Auth.js discovers these two BY NAME ONLY, which is why `auth.ts` calls
# `Google({})` without credentials. The redirect URI must match exactly. Note
# the console does NOT auto-provision: a Google sign-in for an unknown email is
# rejected, so adding someone means creating their row first.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Si el login con Google falla con «no pudo iniciar el login» y el log del
# servidor dice `UNABLE_TO_VERIFY_LEAF_SIGNATURE`, el problema no es una
# credencial: algo está interceptando el TLS —antivirus con escudo web, o el
# proxy de una red corporativa— y presenta su propio certificado, que Node no
# conoce. Node acepta esa CA con `NODE_EXTRA_CA_CERTS` apuntando al .pem del
# interceptor, y la lee AL ARRANCAR EL PROCESO: ponerla en este archivo no
# sirve, porque Next carga el .env después de que Node inicializó TLS. Tiene
# que estar en el entorno desde el que se lanza `next dev`.
# || If Google sign-in fails and the server log says
# `UNABLE_TO_VERIFY_LEAF_SIGNATURE`, it is not a credential: something is
# intercepting TLS and presenting a certificate Node does not know. Node
# accepts that CA via `NODE_EXTRA_CA_CERTS`, which it reads AT PROCESS START —
# putting it in this file does nothing, because Next loads .env after Node has
# initialised TLS. It has to be in the environment `next dev` is launched from.


# =============================================================================
# 4. Base de identidad || Identity database
# =============================================================================
# La base `dw-insu`: usuarios y roles de la consola. Es OTRA base que la del
# corpus (`railway`), aunque vivan en la misma instancia de Postgres.
#
# A propósito NO se llama `DATABASE_URL`: ese nombre ya es el de la base del
# corpus en `ai-service/`, y este monorepo tiene las dos. Una consola apuntada
# al corpus dejaría que Prisma migre tablas que no son suyas.
#
# Crear la base (el guion obliga a comillas en DDL):
#   CREATE DATABASE "dw-insu";
#
# Aplicar el esquema:
#   pnpm exec prisma migrate deploy
#
# || The `dw-insu` database: the console's users and roles. A DIFFERENT
# database from the corpus one, even though both live in the same Postgres
# instance. Deliberately NOT named `DATABASE_URL`: that name already belongs to
# the corpus database in `ai-service/`.

# La que usa el RUNTIME. Va por el pooler cuando hay uno: los Route Handlers
# corren como funciones serverless y una conexión por invocación agota Postgres.
# || The RUNTIME one. Goes through the pooler when there is one: the Route
# Handlers run as serverless functions and one connection per invocation
# exhausts Postgres.
AUTH_DATABASE_URL=postgresql://usuario:clave@host:5432/dw-insu

# La que usan las MIGRACIONES. Directa, sin pooler: una conexión pooled
# multiplexa sentencias entre sesiones y el DDL necesita la suya. Si no hay
# pooler, es la misma de arriba y se puede dejar vacía.
# || The one MIGRATIONS use. Direct, no pooler: a pooled connection multiplexes
# statements across sessions and DDL needs its own. Without a pooler it is the
# same URL and can be left empty.
AUTH_DATABASE_DIRECT_URL=

# Techo de conexiones por instancia serverless. 5 es conservador a propósito:
# el problema no es una función lenta, es cien funciones frías pidiendo su
# conexión al mismo tiempo.
# || Connection ceiling per serverless instance. 5 is conservative on purpose:
# the problem is not one slow function, it is a hundred cold ones asking for a
# connection at once.
AUTH_DATABASE_POOL_MAX=5
