# Copiar a .env y completar. El .env está en .gitignore y NUNCA se commitea.
# || Copy to .env and fill in. The .env is gitignored and is NEVER committed.

# Requerida solo por la capa de embeddings. El chunking NO necesita ninguna key:
# es determinístico y local.
# || Required only by the embedding layer. Chunking needs no key at all:
# it is deterministic and local.
OPENAI_API_KEY=

# Identidad del corpus que se trocea. Se estampa en cada chunk para que el
# vector store pueda aislar un cliente y una versión.
# || Identity of the corpus being chunked. Stamped onto every chunk so the
# vector store can isolate one client and one version.
TENANT_ID=acme_seguros
DOC_VERSION=DW Funtionals 2026.1

# Postgres con pgvector. El default apunta al servicio de docker-compose, cuyas
# credenciales son solo de desarrollo. Un despliegue la sobreescribe.
# || Postgres with pgvector. The default points at the docker-compose service,
# whose credentials are development-only. A deployment overrides this.
DATABASE_URL=postgresql+psycopg://visualtime:visualtime@localhost:5432/visualtime_rag
