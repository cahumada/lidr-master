# Copiar a .env y completar. El .env está en .gitignore y NUNCA se commitea.
# || Copy to .env and fill in. The .env is gitignored and is NEVER committed.

# Requerida solo por la capa de embeddings. El chunking NO necesita ninguna key:
# es determinístico y local.
# || Required only by the embedding layer. Chunking needs no key at all:
# it is deterministic and local.
OPENAI_API_KEY=

# Identidad del corpus que se trocea. Se estampa en cada chunk para que el
# vector store pueda aislar un cliente y una versión.
# || Identity of the corpus being chunked. Stamped onto every chunk so the
# vector store can isolate one client and one version.
TENANT_ID=acme_seguros
DOC_VERSION=DW Funtionals 2026.1

# Postgres con pgvector. El default apunta al servicio de docker-compose, cuyas
# credenciales son solo de desarrollo. Un despliegue la sobreescribe.
# || Postgres with pgvector. The default points at the docker-compose service,
# whose credentials are development-only. A deployment overrides this.
DATABASE_URL=postgresql+psycopg://visualtime:visualtime@localhost:5432/visualtime_rag

# Raiz de los markdown fuente. Solo la necesita el paso de trocear, ya sea por
# CLI (que ademas acepta --root) o por POST /corpus/rebuild. Sin esto, el
# endpoint puede embeber y cargar el corpus que ya este en disco, pero no
# trocear. Es un setting y NO un parametro del request: aceptar una ruta
# arbitraria por HTTP es una lectura de disco arbitraria.
# || Root of the source markdown. Only the chunking step needs it, whether over
# the CLI (which also takes --root) or over POST /corpus/rebuild. Without it the
# endpoint can embed and load whatever corpus is already on disk, but not chunk.
# A setting and NOT a request parameter: accepting an arbitrary path over HTTP is
# an arbitrary disk read.
CORPUS_ROOT=

# Modelo del reranker. NO es el cuello de botella: gpt-4o saco los mismos +11
# pares que gpt-4o-mini a 5,6 s contra 3,3 s. Sin OPENAI_API_KEY el reranker cae
# al lexico, que vale +4 pares medidos.
# || The reranker's model. NOT the bottleneck. Without OPENAI_API_KEY the
# reranker falls back to the lexical one, worth a measured +4 pairs.
RERANK_MODEL=gpt-4o-mini
